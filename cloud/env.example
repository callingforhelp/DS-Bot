# No real values here. Real secrets come from a secret manager, never this file or chat.
MVP_PG_PORT=54329                  # local throwaway Postgres for tests only
DATABASE_URL=                      # managed Postgres (pgvector enabled), app role, not the owner
OBJECT_BUCKET=                     # S3/R2 bucket for immutable artifacts and backups
DAYTONA_API_KEY=                   # scoped project key; sandboxes never receive it
OPENAI_API_KEY=                    # only with OPENAI_EMBEDDINGS_CONSENT=yes (or OPENAI_VOICE_ENABLED=1)
OPENAI_EMBEDDINGS_CONSENT=no       # redacted text leaves the controller only when this is "yes"
OPENAI_VOICE_ENABLED=1             # set to 0/false to disable /v1/voice/* endpoints
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LIVE_MODEL=gpt-live-1.1
OPENAI_LIVE_VOICE=marin
OPENAI_LIVE_IDLE_TIMEOUT_S=15
OPENAI_LIVE_VAD_THRESHOLD=0.5
WECHAT_CALLBACK_SECRET=            # signed callback verification

# Cloudflare R2 (S3-compatible). Create one bucket and an API token limited to Object Read & Write on it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Remote Postgres (host inside the same network: leave HOSTADDR empty; through a tunnel: 127.0.0.1)
DS_BOT_DB_HOST=
DS_BOT_DB_HOSTADDR=
DS_BOT_DB_PORT=5432
DS_BOT_DB_NAME=ds_bot
DS_BOT_DB_USER=
DS_BOT_DB_PASSWORD=
DS_BOT_DB_SSLROOTCERT=
